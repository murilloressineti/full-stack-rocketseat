generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  technician
  client
}

enum TicketStatus {
  open
  in_progress
  closed
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  role             Role      @default(client)
  avatar           String?
  availability     String[]  @default([])   // lista de horários (ex: ['08:00', ...])
  mustChangePassword Boolean @default(false) // quando o admin cria técnico com senha provisória

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // relações
  ticketsCreated   Ticket[]  @relation("ClientTickets")     // tickets onde o user é cliente
  ticketsAssigned  Ticket[]  @relation("TechnicianTickets") // tickets onde o user é técnico
  servicesAdded    TicketService[] @relation("AddedByRelation")
}

model Service {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2) // valor monetário
  active        Boolean        @default(true)     // soft-delete toggle
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // relação
  ticketServices TicketService[]
}

model Ticket {
  id            String        @id @default(uuid())
  title         String?
  description   String?
  status        TicketStatus  @default(open)
  totalPrice    Decimal       @db.Decimal(10, 2) @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // FK fields
  clientId      String
  technicianId  String

  // relações
  client        User          @relation("ClientTickets", fields: [clientId], references: [id], onDelete: Cascade)
  technician    User          @relation("TechnicianTickets", fields: [technicianId], references: [id], onDelete: Restrict)

  services      TicketService[]

  @@index([clientId])
  @@index([technicianId])
}

model TicketService {
  id           String   @id @default(uuid())
  ticketId     String
  serviceId    String

  priceAtTime  Decimal  @db.Decimal(10, 2)
  quantity     Int      @default(1)
  addedById    String?
  createdAt    DateTime @default(now())

  // relações
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id])
  addedBy     User?    @relation("AddedByRelation", fields: [addedById], references: [id])

  @@index([ticketId])
  @@index([serviceId])
  @@unique([ticketId, serviceId])
}